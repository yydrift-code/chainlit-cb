# Caddyfile for external Caddy container
# This should be used in your external Caddy container configuration

{
    # Global options
    email yukhnevsky@gmail.com
    # Uncomment for debugging SSL issues
    # debug
}

# Production domain with automatic HTTPS
realtime-demo.yytech.by {
    reverse_proxy realtime-assistant:8888 {
        flush_interval -1
        header_up Host {host}
        header_up X-Real-IP {remote}
        header_up X-Forwarded-For {remote}
        header_up X-Forwarded-Proto {scheme}
    }
    
    # Enable automatic HTTPS with Let's Encrypt
    # Caddy handles this automatically for valid domains
    
    # Add some security headers
    header {
        # Prevent MIME type sniffing
        X-Content-Type-Options nosniff
        # Enable XSS protection
        X-Frame-Options DENY
        # Enable XSS protection
        X-XSS-Protection "1; mode=block"
        # Don't add HSTS initially to avoid browser caching issues
        # Strict-Transport-Security max-age=31536000;
    }
    
    # Enable logging for debugging
    log {
        output stdout
    }
}
